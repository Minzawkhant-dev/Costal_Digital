# ============================================================================
# Coastal Digital Studio — environment
#
# Copy to .env.local for development. In production set these in the Vercel
# project settings, NOT in a committed file.
#
# Anything prefixed NEXT_PUBLIC_ is inlined into the browser bundle and is
# therefore public. Everything else is server-only and must stay that way.
# ============================================================================

# --- Supabase (required) ----------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bypasses row-level security. Server-only — never prefix this NEXT_PUBLIC_,
# never reference it from a client component, never commit a real value.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Email (Resend) ---------------------------------------------------------
# Without these the form still saves the lead; it just sends no email.
RESEND_API_KEY=re_your_api_key
# Must be a verified sending domain in Resend once you leave testing.
EMAIL_FROM=Coastal Digital Studio <hello@coastaldigitalstudio.com>
# Where new-lead notifications are delivered.
ADMIN_EMAIL=you@yourdomain.com

# --- n8n --------------------------------------------------------------------
# Optional, and purely an extension point: the site already saves the lead,
# emails it, promotes it to a CRM contact with a follow-up task and sends the
# Telegram alert on its own, whether or not n8n responds.
N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/coastal-lead
# Signs the payload as x-coastal-signature (HMAC-SHA256) so your workflow can
# verify the request really came from this site.
N8N_WEBHOOK_SECRET=generate-a-long-random-string

# --- Telegram (optional) --------------------------------------------------
# Admin push alerts for new leads, sent directly by the site so no automation
# host has to be running. Without both values the alert is simply skipped.
# Create a bot with @BotFather; the chat id only becomes available after you
# have messaged the bot once.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Site -------------------------------------------------------------------
# Canonical URL, used for metadata and the sitemap. On Vercel this falls back
# to the deployment URL automatically, so it is only needed for a custom domain.
NEXT_PUBLIC_SITE_URL=https://coastaldigitalstudio.com

# --- Security ---------------------------------------------------------------
# Salt for hashing submitter IP addresses. Changing it resets rate-limit
# buckets. Generate with: openssl rand -hex 32
#
# Optional. Left unset, the salt is derived from SUPABASE_SERVICE_ROLE_KEY,
# which is secret and specific to this deployment. There is deliberately no
# literal default in the source: a salt committed to the repository is public,
# and the whole IPv4 space can be hashed against a known salt in minutes, so
# every stored ip_hash would be reversible. Set this to decouple the two, and
# rotate it without rotating your database key.
IP_HASH_SALT=generate-a-long-random-string
